# ────────────────
# SUPABASE SETTINGS
# ────────────────

# Public credentials (used by Next.js client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service key for backend operations (only used on server)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: Direct Postgres connection (used only by Supabase CLI or seeds)
# SUPABASE_DB_URL=postgresql://postgres:password@db.project.supabase.co:5432/postgres

# ────────────────
# REDIS / PRESENCE CONFIG
# ────────────────

# Upstash Redis (free tier usable)
# Leave Redis unset to use the existing in-memory development presence store.
REDIS_URL=
REDIS_TOKEN=

# (For local mock development — if you’re testing without Redis)
# REDIS_URL=
# REDIS_TOKEN=

# ────────────────
# APP / DEPLOYMENT CONFIG
# ────────────────

# Publicly accessible URL of your deployed instance
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Used by Next.js during dev builds
NODE_ENV=development

# ────────────────
# OPTIONAL INTEGRATIONS
# ────────────────

# If you ever enable email sending (SendGrid, etc.)
# SENDGRID_API_KEY=SG.xxxxx
# EMAIL_FROM=no-reply@redmoon.agency
